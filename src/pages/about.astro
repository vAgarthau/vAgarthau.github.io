<section class="mx-auto mt-16 max-w-xl text-center">
  <SectionHeading title="సంప్రదించండి" />

  <div class="mt-8 space-y-5">
    <p class="telugu text-2xl">
      𝕏
      <a
        href="https://x.com/vAgarthau"
        target="_blank"
        rel="noopener noreferrer"
        class="ml-2 text-[var(--color-accent)] hover:underline"
      >
        @vAgarthau
      </a>
    </p>

    <p class="text-2xl">
      ✉
      <a
        href="mailto:vagarthau1@gmail.com"
        class="ml-2 text-[var(--color-accent)] hover:underline"
      >
        vagarthau1@gmail.com
      </a>
    </p>
