---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="పుట దొరకలేదు | వాగర్థౌ">
  <section class="mx-auto max-w-2xl border-y border-[rgba(123,30,34,0.22)] py-12 text-center">
    <p class="mb-3 text-sm uppercase tracking-[0.16em] text-[var(--color-gold)]">404</p>
    <h1 class="telugu text-5xl font-normal text-[var(--color-accent)]">పుట దొరకలేదు</h1>
    <p class="telugu mt-5 text-2xl leading-9 text-[rgba(43,43,43,0.76)]">
      మీరు వెతుకుతున్న పుట అందుబాటులో లేదు.
    </p>
    <a class="telugu mt-8 inline-block border border-[var(--color-accent)] px-5 py-3 text-2xl text-[var(--color-accent)] hover:bg-[rgba(123,30,34,0.06)]" href="/works/">
      కావ్యములు చూడండి
    </a>
  </section>
</BaseLayout>
