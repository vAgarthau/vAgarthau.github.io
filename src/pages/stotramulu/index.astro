---
import BaseLayout from "@layouts/BaseLayout.astro";
import StotramCard from "@components/StotramCard.astro";
import SectionHeading from "@components/SectionHeading.astro";
---

<BaseLayout title="స్తోత్రములు | వాగర్థౌ">

  <SectionHeading title="స్తోత్రములు" />

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <StotramCard
      title="నారాయణాష్టకం"
      author="శ్రీకృష్ణ బ్రహ్మతంత్ర పరకాల స్వామివారు"
    />
  </div>

</BaseLayout>