---
type Props = {
  verse: {
    telugu: string;
    sanskrit?: string;
    kannada?: string;
    transliteration?: string;
  };
};

const { verse } = Astro.props;

const scripts = [
  { key: "telugu", label: "తెలుగు", text: verse.telugu, lang: "te" },
  { key: "sanskrit", label: "देवनागरी", text: verse.sanskrit, lang: "sa" },
  { key: "kannada", label: "ಕನ್ನಡ", text: verse.kannada, lang: "kn" },
  { key: "iast", label: "IAST", text: verse.transliteration, lang: "iast" },
].filter((s) => s.text);

function panelClass(lang: string) {
  const base = "script-panel sloka whitespace-pre-line text-[var(--color-ink)]";
  if (lang === "te") return `${base} telugu`;
  if (lang === "iast") return `${base} iast-text`;
  if (lang === "sa") return `${base} sanskrit-text`;
  if (lang === "kn") return `${base} kannada-text`;
  return base;
}
---

{scripts.length > 1 && (
  <div class="script-toggle mb-6 flex flex-wrap gap-2">
{scripts.map((s, i) => (
  <button
    type="button"
    class:list={[
          "script-toggle-btn inline-flex h-10 items-center justify-center rounded border border-[rgba(184,144,58,0.35)] px-4 text-lg transition-colors data-[active=true]:border-[var(--color-gold)] data-[active=true]:bg-[rgba(184,144,58,0.12)] data-[active=true]:text-[var(--color-accent)] data-[active=true]:font-semibold",
          s.lang === "te" && "telugu",
          s.lang === "sa" && "devanagari-label",
        ]}
        data-script={s.key}
        data-active={i === 0 ? "true" : "false"}
      >
        {s.label}
      </button>
    ))}
  </div>
)}

{scripts.map((s, i) => (
  <div
    class={panelClass(s.lang)}
    style="font-size: clamp(1.375rem, 1.6vw + 1rem, 2rem); line-height: 1.9;"
    data-script-panel={s.key}
    data-visible={i === 0 ? "true" : "false"}
  >
    {s.text}
  </div>
))}

<script>
  document.querySelectorAll(".script-toggle").forEach((toggle) => {
    toggle.querySelectorAll(".script-toggle-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.getAttribute("data-script");

        toggle.querySelectorAll(".script-toggle-btn").forEach((b) => {
          b.setAttribute("data-active", b === btn ? "true" : "false");
        });

        document.querySelectorAll("[data-script-panel]").forEach((panel) => {
          panel.setAttribute(
            "data-visible",
            panel.getAttribute("data-script-panel") === key ? "true" : "false",
          );
        });
      });
    });
  });
</script>

<style>
  .script-panel[data-visible="false"] {
    display: none;
  }

  .iast-text {
    font-family: "Noto Serif", serif;
    font-style: italic;
    font-size: clamp(1.4rem, 0.7vw + 0.8rem, 1.25rem) !important;
    line-height: 2 !important;
    word-break: break-word;
  }

  .sanskrit-text {
    font-family: "Noto Serif Devanagari", serif;
  }

  .kannada-text {
  font-family: "Noto Serif Kannada", serif;
  font-size: clamp(1.25rem, 1.45vw + 0.9rem, 1.65rem) !important;
  line-height: 1.9 !important;
  }
</style>