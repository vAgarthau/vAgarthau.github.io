---
import "../styles/global.css";
import SiteHeader from "@components/SiteHeader.astro";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "vAgarthau",
  description = "A digital library for Telugu works.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Sree+Krushnadevaraya&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen text-[var(--color-ink)]">
    <SiteHeader />
    <main class="mx-auto w-full max-w-6xl px-5 py-10 sm:px-8 lg:px-10">
      <slot />
    </main>
  </body>
</html>
