---
import "../styles/global.css";
import SiteHeader from "@components/SiteHeader.astro";

type Props = {
  title?: string;
  description?: string;
  wide?: boolean;
};

const {
  title = "vAgarthau",
  description = "A digital library for Telugu works.",
  wide = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Tenali+Ramakrishna&family=Noto+Serif:ital,wght@0,400..600;1,400..600&family=Noto+Serif+Devanagari:wght@400..600&family=Noto+Serif+Kannada:wght@400..600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen text-[var(--color-ink)]">
    <SiteHeader />
    <main class:list={["mx-auto w-full px-5 py-10 sm:px-8 lg:px-10", wide ? "max-w-[1600px]" : "max-w-6xl"]}>
      <slot />
    </main>
  </body>
</html>
